# ===== AI Shorts Maker - cấu hình =====
# Copy file này thành ".env" rồi điền API key.

# Nhà cung cấp tạo ảnh: gemini | openai | placeholder
#   placeholder = ảnh nền màu (miễn phí, dùng để test nhanh, không cần key)
IMAGE_PROVIDER=gemini

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Số ảnh tạo song song (giảm xuống nếu bị lỗi rate limit)
IMAGE_CONCURRENCY=3

# Cổng web
PORT=8000

# Số giây hiện ảnh thumbnail ở đầu video (nếu dự án có thumbnail)
THUMB_SECONDS=0.5
